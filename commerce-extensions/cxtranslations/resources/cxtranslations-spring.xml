	<!-- AI	-->
	<bean id="cxTranslateModelParametersHandler"
		  class="com.sap.cx.translations.dynamicattributes.CxTranslateModelParametersHandler"/>

	<bean id="cxAiTranslationService" class="com.sap.cx.translations.serviceinterfaces.ai.impl.CxAiTranslationServiceImpl"
		  parent="cxTranslateAbstractRestService">
		<property name="interfacePropertiesName" value="cxtranslate.integrations.ai"/>
		<property name="integrationRestTemplateFactory" ref="cxTranslateRestTemplateFactory"/>
	</bean>

	<bean id="cxDeepLTranslationInterfaceService" class="com.sap.cx.translations.serviceinterfaces.deepl.CxTranslationsDeeplInterfaceService"
		  parent="cxTranslateAbstractRestService">
		<property name="interfacePropertiesName" value="cxtranslate.integrations.deepl"/>
		<property name="integrationRestTemplateFactory" ref="cxTranslateRestTemplateFactory"/>
	</bean>

	<!-- Integration	-->

    <!-- Custom connection configuration, introduced because default one is global, and we want to increase timeouts
    for CX Translate calls without affecting other interfaces.
    Below is a "chain" of custom bean declaration to make the interfaces actually use this config  -->
    <bean id="cxTranslateOutboundServicesConfiguration" class="com.sap.cx.translations.integration.configuration.CxTranslateOutboundServicesConfiguration" parent="defaultOutboundServicesConfiguration"/>

    <!-- Request factory that uses our custom config    -->
    <bean id="cxTranslateOutboundClientHttpRequestFactory" parent="defaultOutboundClientHttpRequestFactory">
        <property  name="configuration" ref="cxTranslateOutboundServicesConfiguration"/>
    </bean>

    <!-- Oauth2 based template creator that uses our custom Request Factory (to increase timeouts)    -->
    <bean id="cxTranslateIntegrationOAuth2RestTemplateCreator" parent="defaultIntegrationOAuth2RestTemplateCreator">
        <property name="clientHttpRequestFactory" ref="cxTranslateOutboundClientHttpRequestFactory"/>
    </bean>

    <!-- Custom Rest Template creator for Translation Services that require custom Authentication Headers -->
    <bean id="cxTranslateKeyBasedRestTemplateCreator" parent="abstractRestTemplateCreator"
          class="com.sap.cx.translations.integration.resttemplate.CxTranslateKeyBasedRestTemplateCreator">
        <property name="clientHttpRequestFactory" ref="cxTranslateOutboundClientHttpRequestFactory"/>
    </bean>

    <util:list id="cxTranslateRestTemplateCreators">
        <ref bean="cxTranslateKeyBasedRestTemplateCreator"/>
        <ref bean="cxTranslateIntegrationOAuth2RestTemplateCreator"/>
    </util:list>

    <!-- Combined with default implementation, if there is no custom implementation handling the Destination, some OOTB possibly can do that -->
    <bean id="cxTranslateCombinedRestTemplateCreators" class="org.apache.commons.collections4.ListUtils" factory-method="sum">
        <constructor-arg ref="cxTranslateRestTemplateCreators"/>
        <constructor-arg ref="defaultIntegrationRestTemplateStrategiesList"/>
    </bean>

    <bean id="cxTranslateRestTemplateFactory" parent="defaultIntegrationRestTemplateFactory">
        <property name="restTemplateCreators" ref="cxTranslateCombinedRestTemplateCreators"/>
    </bean>


	<bean name="defaultCxTranslateRestErrorStrategy"
		  class="com.sap.cx.translations.integration.strategy.impl.DefaultCxTranslateRestErrorStrategy"/>
	<bean id="cxTranslateAbstractRestService" class="com.sap.cx.translations.integration.CxTranslateOutboundAbstractRestService"
		  abstract="true">
		<property name="restErrorStrategy" ref="defaultCxTranslateRestErrorStrategy"/>
		<property name="responseErrorHandler" ref="cxTranslateResponseErrorHandler"/>
        <property name="integrationRestTemplateFactory" ref="cxTranslateRestTemplateFactory"/>
	</bean>


	<bean id="cxTranslationJob" class="com.sap.cx.translations.jobs.CxTranslationJob" parent="abstractJobPerformable">
