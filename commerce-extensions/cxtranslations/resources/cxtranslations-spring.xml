<beans xmlns="http://www.springframework.org/schema/beans"
	   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	   xmlns:aop="http://www.springframework.org/schema/aop"
	   xmlns:context="http://www.springframework.org/schema/context"
	   xmlns:util="http://www.springframework.org/schema/util"
	   xsi:schemaLocation="http://www.springframework.org/schema/beans
           http://www.springframework.org/schema/beans/spring-beans.xsd
           http://www.springframework.org/schema/aop
           http://www.springframework.org/schema/aop/spring-aop.xsd
           http://www.springframework.org/schema/context
           http://www.springframework.org/schema/context/spring-context.xsd
		   http://www.springframework.org/schema/util
		   http://www.springframework.org/schema/util/spring-util.xsd">

	<context:annotation-config/>

	<bean id="cxTranslationsFacade" class="com.sap.cx.translations.facades.impl.CxTranslationsFacadeImpl">
		<property name="translationsService" ref="cxTranslationsService"/>
		<property name="modelService" ref="modelService"/>
		<property name="cacheController" ref="cacheController"/>
		<property name="cxLocalizedLabelCacheKeyProvider" ref="cxLocalizedLabelCacheKeyProvider"/>
		<property name="configurationService" ref="configurationService"/>
		<property name="translationsCatalogVersionStrategy" ref="cxTranslationsCatalogVersionStrategy"/>
		<property name="sessionSearchRestrictionsDisabler" ref="cmsSessionSearchRestrictionsDisabler"/>
		<property name="setupSyncJobService" ref="setupSyncJobService"/>
		<property name="cxTranslateCommerceCommonI18NService" ref="cxTranslateCommerceCommonI18NService"/>
		<property name="userService" ref="userService"/>
		<property name="sessionService" ref="sessionService"/>
	</bean>

	<bean id="cxLocalizedLabelDao" class="com.sap.cx.translations.daos.impl.CxLocalizedLabelDaoImpl"/>

	<bean id="cxLocalizedBundleDao" class="com.sap.cx.translations.daos.impl.CxLocalizedBundleDaoImpl"/>

	<bean id="cxProposedTranslationDao" class="com.sap.cx.translations.daos.impl.CxProposedTranslationDaoImpl"/>

	<bean id="cxAiTranslationServiceSettingsDao"
		  class="com.sap.cx.translations.daos.impl.CxTranslationServiceSettingsDaoImpl"/>

	<bean id="cxTranslationsService"
		  class="com.sap.cx.translations.services.impl.CxTranslationsServiceImpl">
		<property name="labelDao" ref="cxLocalizedLabelDao"/>
		<property name="bundleDao" ref="cxLocalizedBundleDao"/>
		<property name="modelService" ref="modelService"/>
		<property name="eventService" ref="eventService"/>
		<property name="keySuggestionsLimit" value="${cxtranslations.keysuggestions.limit}"/>
		<property name="userGroupsAllowedForFrontendTranslation" value="${cxtranslations.frontend.usergroups}"/>
	</bean>

	<bean id="cxLocalizedMessagesService"
		  class="com.sap.cx.translations.services.impl.CxLocalizedMessagesServiceImpl">
		<property name="messageSource" ref="cxDatabaseMessageSource"/>
		<property name="i18NService" ref="i18NService"/>
	</bean>

	<bean id="cxTranslationsCatalogVersionStrategy"
		  class="com.sap.cx.translations.strategies.impl.CxTranslationsCatalogVersionStrategyImpl">
		<property name="cmsSiteService" ref="cmsSiteService"/>
		<property name="catalogVersionService" ref="catalogVersionService"/>
		<property name="sessionSearchRestrictionsDisabler" ref="cmsSessionSearchRestrictionsDisabler"/>
        <property name="catalogService" ref="catalogService"/>
        <property name="defaultTranslationCatalogId" value="${cxtranslations.default.catalog.id}"/>
	</bean>

	<bean id="cxAbstractDatabaseMessageSource" class="com.sap.cx.translations.messages.CxDatabaseMessageSource"
		  abstract="true">
		<property name="translationsFacade" ref="cxTranslationsFacade"/>
		<property name="sessionService" ref="sessionService"/>
		<property name="commerceCommonI18NService" ref="commerceCommonI18NService"/>
		<property name="commonI18NService" ref="commonI18NService"/>
	</bean>

	<bean id="cxDatabaseMessageSource" parent="cxAbstractDatabaseMessageSource"/>
	<aop:config proxy-target-class="true">
		<aop:aspect ref="cxMessageSourceAspect">
			<aop:pointcut id="pointCutAround"
						  expression="target(org.springframework.context.MessageSource) and execution(* getMessage*(..))"/>
			<aop:around method="delegateToDatabaseMessageSource" pointcut-ref="pointCutAround"/>
		</aop:aspect>
	</aop:config>
	<bean id="cxMessageSourceAspect" class="com.sap.cx.translations.aspects.CxMessageSourceAspect">
		<constructor-arg name="messageSource" ref="cxDatabaseMessageSource"/>
        <property name="enabled" value="${cxtranslations.backendTranslations.messageSourceAspect.enabled}"/>
	</bean>

	<bean id="cxLocalizedLabelCacheKeyProvider"
		  class="com.sap.cx.translations.cache.impl.CxLocalizedLabelCacheKeyProviderImpl">
		<property name="commerceCommonI18NService" ref="commerceCommonI18NService"/>
	</bean>

	<bean id="cxRelatedLabelsAttributeHandler"
		  class="com.sap.cx.translations.dynamicattributes.CxRelatedLabelsAttributeHandler">
		<property name="cxLocalizedLabelDao" ref="cxLocalizedLabelDao"/>
		<property name="i18nextSuffixes" value="${cxtranslations.i18next.suffixes}"/>
	</bean>

