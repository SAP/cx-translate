        <constructor-arg name="modelService" ref="modelService"/>
        <constructor-arg name="commonI18NService" ref="commonI18NService"/>
        <constructor-arg name="pluralSuffixes" value="${cxtranslations.i18next.suffixes}"/>
    </bean>

	<bean id="cxClearLabelsCacheEventListener" class="com.sap.cx.translations.events.CxClearLabelsCacheEventListener"
		  parent="abstractEventListener">
		<property name="cacheController" ref="cacheController"/>
		<property name="configurationService" ref="configurationService"/>
	</bean>

