		<property name="mediaService" ref="mediaService"/>
	</bean>

	<bean id="cxAzureTranslatorTranslationStrategy" class="com.sap.cx.translations.services.impl.automatictranslation.impl.CxAzureTranslatorTranslationStrategyImpl">
		<property name="modelService" ref="modelService"/>
		<property name="i18nService" ref="cxTranslateCommerceCommonI18NService"/>
		<property name="interfaceService" ref="cxAzureTranslatorInterfaceService"/>
		<property name="languageMap">
			<map>
				<!-- Azure Translator BCP-47 overrides for isocodes that don't map trivially.
				     Azure uses shorter tags than SAP Translation Hub (e.g. "zh-Hans" not "zh-CN").
				     Full list: https://learn.microsoft.com/en-us/azure/ai-services/translator/language-support -->
				<entry key="zh" value="zh-Hans"/>
