		  class="com.sap.cx.translations.dynamicattributes.CxProposedTranslationsAttributeHandler">
		<property name="cxProposedTranslationDao" ref="cxProposedTranslationDao"/>
	</bean>

	<bean id="cxTranslateResponseErrorHandler"
		  class="com.sap.cx.translations.integration.handler.CxTranslateResponseErrorHandler">
		<property name="ignoredHttpErrorCodes">
			<list>
				<value>408</value>
			</list>
		</property>
