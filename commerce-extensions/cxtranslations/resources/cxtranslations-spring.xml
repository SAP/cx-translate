        <property name="flexibleSearchService" ref="flexibleSearchService"/>
        <property name="cxLocalizedClassificationService" ref="cxLocalizedClassificationService"/>
        <property name="commonI18NService" ref="commonI18NService"/>
        <property name="valueSearchLimit" value="${cxtranslations.standardProvider.searchByValueLimit:1000}"/>
    </bean>

	<util:list id="cxProviderFactoryStrategies">
		<ref bean="cxStandardLocalizedObjectProviderFactoryStrategy"/>
		<ref bean="cxProductFeatureLocalizedObjectProviderFactoryStrategy"/>
