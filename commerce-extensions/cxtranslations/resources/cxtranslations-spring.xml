          class="com.sap.cx.translations.dynamicattributes.CxAiServiceCostAttributeHandler"/>
    <bean id="cxTranslationCronJobCostAttributeHandler"
          class="com.sap.cx.translations.dynamicattributes.CxTranslationCronJobCostAttributeHandler"/>

	<bean id="cxTranslateLocalizedValueAttributeHandler"
		  class="com.sap.cx.translations.dynamicattributes.CxTranslateLocalizedValueAttributeHandler">
		<property name="modelService" ref="modelService"/>
		<property name="commonI18NService" ref="commonI18NService"/>
