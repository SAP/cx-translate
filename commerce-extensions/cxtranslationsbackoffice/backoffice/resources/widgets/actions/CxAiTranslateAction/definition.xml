<action-definition xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
				   id="com.sap.cx.translations.backoffice.widgets.actions.aitranslate"
				   xsi:noNamespaceSchemaLocation="http://www.hybris.com/schema/cockpitng/action-definition.xsd">

	<name>AI Translate Actions</name>
	<description>Action translating localized Values by AI or other external service.</description>
	<author>hybris</author>
	<version>1.0</version>

	<sockets>
		<output id="itemsToTranslate"/>
		<output id="valuesToTranslate"/>
	</sockets>

	<iconUri>translate</iconUri>
	<actionClassName>com.sap.cx.translations.backoffice.actions.CxAiTranslateListViewAction</actionClassName>

	<settings>
		<setting key="max.rows" default-value="3000" type="java.lang.Integer"/>
		<setting key="safety.threshold" default-value="1000" type="java.lang.Integer"/>
	</settings>

</action-definition>
