<action-definition xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
				   id="com.sap.cx.translations.backoffice.widgets.actions.listview.approvetranslations"
				   xsi:noNamespaceSchemaLocation="http://www.hybris.com/schema/cockpitng/action-definition.xsd">

	<sockets>
		<output id="itemsToApprove"/>
	</sockets>

	<name>Approve proposed translations action</name>
	<description>Action approving the proposed translations.</description>
	<author>hybris</author>
	<version>1.0</version>

	<iconUri>accept</iconUri>
	<actionClassName>com.sap.cx.translations.backoffice.actions.CxApproveAiTranslationsListViewAction</actionClassName>

	<settings>
		<setting key="max.rows" default-value="5000" type="java.lang.Integer"/>
		<setting key="safety.threshold" default-value="3000" type="java.lang.Integer"/>
	</settings>

</action-definition>
