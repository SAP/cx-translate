INSERT_UPDATE CxAiTranslationServiceApi; code[unique = true]; name     ; endpointUrlSuffix                                                              ; responsePath                 ; configurableParameters; defaultParameterValues[map-delimiter = |, key2value-delimiter = ->]; deploymentConfiguration(code);
                                       ; sapBtpAiOpenAiGpt5 ; Chat GPT ; /v2/inference/deployments/{deployment}/chat/completions?api-version=2024-10-21 ; $.choices[0].message.content ; reasoning_effort      ; reasoning_effort->minimal                                          ; default                      ;

UPDATE CxAiTranslationServiceApi; code[unique = true]; requestTemplate
                                ; sapBtpAiOpenAiGpt5 ; "{
    ""model"": ""${model}"",
    ""response_format"": { ""type"": ""json_object"" },

    ""reasoning_effort"": ""${parameters.reasoning_effort}"",

    ""messages"": [
      {
        ""content"": ""You are expert language translator API. Use 'feedback' response field to provide comment If there is ambiguity of meaning ,doubt about  style/form or errors/typos in input text. If the content is a html template where localized content is not hardcoded but taken from message bundles, then copy it 1:1 without translation.  If `translationToComplete` is provided then you ALWAYS MUST start with provided content (exactly, including any leading white spaces or other special characters). Try to copy exactly as much characters from existing translation as possible.  Then find the proper place in the source text and continue with translation. You can change part of text near the end in `existingTranslation` to provide proper translation on the boundary. NEVER forget to translate content that is after the provided existing translation!!! Take time to find the proper text to translate and use it. Preserve HTML tags and other markup or template macros.  The expected response schema (don't include schema itself in the response only main fields, don't include ```json marker): ${responseSchemaJson}"",
        ""role"": ""system""
      },
      {
        ""content"": ""${requestJson}"",
        ""role"": ""user""
      }
    ]
  }"


INSERT_UPDATE CxAiTranslationServiceApi; code[unique = true]; usageMetricsPaths[map-delimiter = |, key2value-delimiter = ->];
                                       ; sapBtpAiOpenAiGpt5 ; inputTokens->$.usage.prompt_tokens|outputTokens->$.usage.completion_tokens

INSERT_UPDATE CxAiTranslationServiceSettings; code[unique = true]; name                      ; aiServiceApi(code) ; aiModel(code); isDefault[default = false]; maxLanguagesInRequest
                                            ; gpt5               ; GPT-5 (complex texts)     ; sapBtpAiOpenAiGpt5 ; gpt-5        ; false                     ; 2
                                            ; gpt5Mini           ; GPT-5 Mini (default)      ; sapBtpAiOpenAiGpt5 ; gpt-5-mini   ; true                      ; 2
                                            ; gpt5Nano           ; GPT-5 Nano (simple texts) ; sapBtpAiOpenAiGpt5 ; gpt-5-nano   ; false                     ; 2


UPDATE CxAiTranslationServiceSettings; code[unique = true]; usageMetricsCost[map-delimiter = |, key2value-delimiter = ->]
                                     ; gpt5               ; inputTokens->0   | outputTokens-> 0
                                     ; gpt5Mini           ; inputTokens->0   | outputTokens-> 0
                                     ; gpt5Nano           ; inputTokens->0   | outputTokens-> 0
