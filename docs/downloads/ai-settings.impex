# Update in the impex - required changes indicated by the <<CHANGE_ME>>:
#   -macros related to OAUTH and URLs below
#   -mapping of model to Deployment ID in CxAiDeploymentConfig

UPDATE GenericItem[processor = de.hybris.platform.commerceservices.impex.impl.ConfigPropertyImportProcessor]; pk[unique = true]

########################################
# UPDATE THE <<CHANGE_ME>> BELOW
########################################
$oAuthClientId = <<CHANGE_ME>>
$oAuthSecret = <<CHANGE_ME>>
$oAuthUrl = <<CHANGE_ME>>
$aiBaseUrl = https://change.me.sap.com
########################################

